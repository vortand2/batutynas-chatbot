      "N8N_WEBHOOK_URL": "https://n8n-n8n.0uvai5.easypanel.host/webhook/batutynas-booking-notify",
      "CALENDAR_BRIDGE_URL": "https://n8n-n8n.0uvai5.easypanel.host/webhook/batutynas-availability",
