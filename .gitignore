# ============================================================
# CREDENTIALS — never commit real secrets
# Store actual values in a local .env file or a password manager.
# Files with hardcoded secrets must use *_PLACEHOLDER values only.
# ============================================================
.DS_Store
.env
*.env
*.env.local
*.env.*
node_modules/
.idea/
.vscode/

# MCP config (contains API keys)
.mcp.json

# Credential / secret files
credentials/
secrets/
CLAUDE.md

# n8n workflow exports containing embedded secrets
chatwoot/chatwoot-main.json
*.credentials.json
*.secrets.json
*.secret

# n8n live workflow exports — regenerable from build-*.py + REST API
# These have leaked Gemini keys 3× via Google's GitHub scanner.
# Keep builders (.py) tracked; output JSON is artifact, not source of truth.
n8n-workflows/*-workflow.json

# BFG / git history cleanup artifacts
secrets-to-purge.txt

# Unrelated projects
land-search-agent/
other-examples/

# Docker / build artifacts
backups/
