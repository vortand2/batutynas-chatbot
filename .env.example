# Batutynas workflow builder secrets
# Copy to .env and fill in real values: cp .env.example .env
# Source before running builders: source .env && python3 n8n-workflows/build-*.py

export BATUTYNAS_BOT_TOKEN="your-telegram-bot-token"
export BATUTYNAS_OWNER_CHAT_ID="your-telegram-chat-id"
export GEMINI_API_KEY="your-gemini-api-key"
export BATUTYNAS_OWNER_EMAIL="your@email.com"
