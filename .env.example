# ═══════════════════════════════════════════════════════════════════════════════
# Batutynas Chatbot — .env konfigūracija
# Nukopijuokite: cp .env.example .env && nano .env
# ═══════════════════════════════════════════════════════════════════════════════

# ── Docker Compose (chatbot sistema) ─────────────────────────────────────────

# Jūsų domenas (be pabaigos /)
DOMAIN=https://batutynas.lt

# MongoDB (nereikia keisti kai naudojate Docker Compose)
DB_NAME=batutynas_db

# CORS – jūsų domenai, atskirti kableliu
CORS_ORIGINS=https://batutynas.lt,https://www.batutynas.lt

# El. paštas (nemokamas planas: resend.com)
OWNER_EMAIL=dovydasdobrovolskis@gmail.com
RESEND_API_KEY=

# Google Gemini AI (aistudio.google.com/apikey)
GEMINI_API_KEY=

# n8n integracija
N8N_BASE_URL=https://n8n-n8n.0uvai5.easypanel.host
N8N_WEBHOOK_URL=https://n8n-n8n.0uvai5.easypanel.host/webhook/batutynas-booking-notify
CALENDAR_BRIDGE_URL=https://n8n-n8n.0uvai5.easypanel.host/webhook/batutynas-availability

# Admin panelė (pasirinkite saugų slaptažodį)
ADMIN_PASSWORD=

# n8n <-> chatbot sinchronizavimas (slaptas raktas)
N8N_SYNC_SECRET=replace-me-generate-a-random-32-byte-secret

# Google Maps (maršruto planuoklė — Geocoding + Directions + Static Maps)
GOOGLE_MAPS_API_KEY=

# ── n8n workflow builders (legacy) ───────────────────────────────────────────
# Source before running: source .env && python3 n8n-workflows/build-*.py

export BATUTYNAS_BOT_TOKEN="your-telegram-bot-token"
export BATUTYNAS_OWNER_CHAT_ID="your-telegram-chat-id"
export BATUTYNAS_OWNER_EMAIL="dovydasdobrovolskis@gmail.com"
